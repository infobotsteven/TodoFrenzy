# Copy to .env and adjust

# Listen on the whole local network (0.0.0.0) so phones can connect
HOST=0.0.0.0
PORT=3000

# Path to the SQLite file (in Docker it is set by docker-compose.yml, this value is ignored there)
DATABASE_PATH=./data/todo.db

# Docker only: the port on the host machine (the container always uses 3000 inside). Change it if 3100 is taken.
# TODOFRENZY_PORT=3100

# Backups: directory and number of files kept (npm run db:backup)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# --- Login (one shared account) ---
# With none of the settings below, admin/admin applies (the server warns in its log) - CHANGE the password before sharing the app with others.
# AUTH_USER=admin
# Recommended: a password hash. Generate it with:  npm run auth:hash -- "yourPassword"  and paste the result (the value in single quotes):
# AUTH_PASSWORD_HASH='scrypt$16384$...'
# Or a plain password (less safe if someone sees this file):
# AUTH_PASSWORD=yourPassword
# Changing the login or password invalidates all existing sessions (after a server restart).
# A session lasts 7 days from the last activity (seconds); after 5 failed attempts from one IP address login is locked for 15 minutes:
# AUTH_SESSION_SECONDS=604800
# AUTH_MAX_ATTEMPTS=5
# AUTH_LOCK_SECONDS=900
