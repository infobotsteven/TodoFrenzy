{
  "name": "@todo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "db:backup": "tsx --env-file-if-exists=../.env src/db/backup-cli.ts",
    "auth:hash": "tsx src/auth-hash-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@todo/shared": "*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0"
  }
}
